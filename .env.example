# Port web (default 8080)
PORT=8080
# Folder database & kunci rahasia (default ./data)
DATA_DIR=./data
# Interval cek voucher dalam milidetik (default 30 detik)
SCHEDULER_INTERVAL_MS=30000
# Port halaman isolir PPPoE (default 8081)
ISOLIR_PORT=8081
# Isi 1 jika Wifinate di belakang reverse proxy (Caddy/Nginx) supaya IP pengunjung terbaca benar
TRUST_PROXY=0
